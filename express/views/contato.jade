doctype html
html
  head
    title= title
    meta(charset='utf-8')
    meta(name='viewport', content='width=device-width, initial-scale=1')
    link(rel='stylesheet', href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css')
    link(rel='stylesheet', href='/stylesheets/style.css')
  body.bg-light
    nav.navbar.navbar-expand-lg.navbar-dark.bg-dark
      .container
        a.navbar-brand(href='/') Meu Site
        button.navbar-toggler(type='button', data-bs-toggle='collapse', data-bs-target='#navbarNav')
          span.navbar-toggler-icon
        #navbarNav.collapse.navbar-collapse
          ul.navbar-nav.ms-auto
            li.nav-item
              a.nav-link(href='/') Início
            li.nav-item
              a.nav-link(href='/sobre') Sobre
            li.nav-item
              a.nav-link.active(href='/contato') Contato
    .container.py-5
      .row.justify-content-center
        .col-lg-8
          .card.shadow-sm.border-0
            .card-body.p-5
              h1.display-6.fw-bold.mb-3 Contato
              p.lead.mb-4 Esta é a página de contato com Bootstrap.
              .list-group
                .list-group-item
                  strong E-mail:
                  |  contato@exemplo.com
                .list-group-item
                  strong Telefone:
                  |  (00) 0000-0000
    script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js')